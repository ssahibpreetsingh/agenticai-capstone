# Copy this file to .env and fill in ONE provider block.
# Never commit your real .env file (it should already be in .gitignore).


SCENARIO="banking"
# ---- Choose your provider ----
# One of: azure | openai | anthropic | openai_compatible | ollama | OpenRouter
LLM_PROVIDER=openrouter

# ---- Option : Open Router ------
OPENROUTER_API_KEY=
# ---- Option A: Azure OpenAI ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ---- Option B: OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Option C: Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Option D: Any OpenAI-compatible endpoint (Groq, Mistral, Together, etc.) ----
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ---- Option E: Ollama (local, free) ----
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# ---- Shared settings ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
SCENARIO=banking
# banking | healthcare
